<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            PHPUnit runs the whole suite in one process, so the framework
            instances every test boots accumulate. The suite crossed PHP's 128M
            default and started dying with "Premature end of PHP process" part
            way through, which reads like a broken test rather than the resource
            limit it actually is.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Routes are registered at boot, before a test can set config(), so the
             subdomain status-page route needs its host from the environment. -->
        <env name="STATUS_PAGE_SUBDOMAIN_HOST" value="uptizm.test"/>
        <!-- The staff panel's host, declared here for the same reason as the line
             above: PanelIsolationTest asserts that the panel owns the ROOT of a host
             that sits UNDER the wildcard status-page domain, which is the only
             arrangement in which the production-only collision it guards can happen
             at all. Left to a developer's own .env the value drifts (a local
             ADMIN_HOST=admin.localhost shares no parent with uptizm.test), the
             wildcard could never have matched it, and the guard fails loudly rather
             than certifying a tautology. Which it did. -->
        <env name="ADMIN_HOST" value="admin.uptizm.test"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Third-party credentials the suite must never hold, pinned EMPTY for
            the same reason CACHE_STORE and DB_CONNECTION are pinned above: a
            developer who exports one of these in their shell would otherwise
            run a different suite than CI does, and the difference is a live
            outbound request rather than a slower assertion. Both integrations
            are dormant-when-unconfigured by design, so an empty value is also
            the branch worth exercising. Measured: with KODIZM_MCP_TOKEN in this
            machine's environment, a research-tool test sent a real request to
            mcp.kodizm.com before it was pinned.
        -->
        <env name="KODIZM_MCP_TOKEN" value=""/>
        <env name="IPINFO_TOKEN" value=""/>
    </php>
</phpunit>
