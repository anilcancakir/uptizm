APP_NAME=Uptizm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Also the disk Filament writes uploads to. Filament v4 derives its
# `default_filesystem_disk` from THIS key (vendor/filament/support/config/filament.php),
# where v3 hardcoded `public`, so a staff upload lands on `local` (private, not
# web-served) unless this is changed or `config/filament.php` is published. There
# is no `FILAMENT_FILESYSTEM_DISK` in v4; setting one would be dead configuration.
FILESYSTEM_DISK=local

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

SANCTUM_STATEFUL_DOMAINS=

MAGIC_STARTER_ROUTE_PREFIX=api/v1
MAGIC_STARTER_FRONTEND_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

AI_DEFAULT=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AI_BUDGET_DAILY_PER_TEAM=100
AI_TRIAGE_MODEL=claude-haiku-4-5-20251001
# AI_ANALYSIS_MODEL and AI_METRIC_DISCOVERY_MODEL are deliberately COMMENTED OUT.
# Both fall back through AI_TRIAGE_MODEL, so a deployment that moves the AI
# surface to another provider sets AI_DEFAULT and AI_TRIAGE_MODEL and every
# gateway follows. Copying a literal id into a real .env is what breaks that:
# the file would then pin these two to a model the new provider does not serve,
# each analyze would fail, the endpoint's degrade would answer deterministically,
# and the feature would look healthy while doing nothing. Set one only to run a
# DIFFERENT model for that one task on purpose.
# AI_ANALYSIS_MODEL=
# AI_METRIC_DISCOVERY_MODEL=
AI_DIGEST_MAX_CHARACTERS=8000

IPINFO_TOKEN=

KODIZM_MCP_URL=https://mcp.kodizm.com/
KODIZM_MCP_TOKEN=
KODIZM_MCP_TIMEOUT_SECONDS=12

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail: MAIL_MAILER=resend plus the API key from the Resend
# dashboard. Empty here on purpose, and the defaults above are why the contact
# form stays withheld locally: `log` cannot send, so the page offers no form.
# See deploy/README.md for the cutover (domain verification, SPF, DKIM).
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

CORS_ALLOWED_ORIGINS=*

# Base host for subdomain-addressed status pages (`{slug}.<host>`). Leave empty
# to register no wildcard host route at all. Production: uptizm.com
STATUS_PAGE_SUBDOMAIN_HOST=

# The host the Filament staff panel answers on, and the ONLY host it answers on.
# The panel owns that host's ROOT (login at `<host>/login`, dashboard at
# `<host>/dashboard`), so this must never be the apex: the apex root is the
# marketing landing page, and the panel carries session + cookie middleware the
# marketing and status pages publish that they do not. Note the interaction with
# STATUS_PAGE_SUBDOMAIN_HOST above: once that is set, every unclaimed label under
# it is matched by the wildcard status-page route, so `admin` must be a label the
# panel owns outright (`tests/Feature/Admin/PanelIsolationTest.php` pins it).
# Left empty here it falls back to `admin.<APP_URL host>`, never to no constraint
# at all. Production: admin.uptizm.com
ADMIN_HOST=

# The staff panel's access allowlist: comma-separated email addresses, matched
# case-insensitively with surrounding whitespace stripped. EMPTY DENIES EVERYONE
# and that is the correct default; the panel's login page is publicly reachable
# and the console behind it has cross-team CRUD over every user and monitor.
UPTIZM_STAFF_EMAILS=

# The internal team that owns the public service catalog's monitors, and the
# address of the user row that owns that team. That user never logs in and holds
# no team membership, which is what keeps a service outage from paging anybody;
# keep its address OUT of UPTIZM_STAFF_EMAILS. The default sits under the
# reserved `.invalid` TLD so it can never be delivered to.
UPTIZM_SYSTEM_TEAM_NAME="Uptizm Services"
UPTIZM_SYSTEM_TEAM_EMAIL=system@uptizm.invalid

# How the service-feed ingester introduces itself. Names the product and carries
# a contact URL, which is what a provider's robots policy asks of an automated
# client and what lets an operator reach us instead of blocking us. Never a
# browser User-Agent.
UPTIZM_BOT_USER_AGENT="UptizmBot/1.0 (+https://uptizm.com/bot)"

# Where the Flutter web client is served, for the landing page's sign-in links.
# Production: https://app.uptizm.com
APP_FRONTEND_URL=

# The path prefix the Flutter client mounts its auth screens under. MIRRORS
# `auth_prefix` in the client's lib/config/magic_starter.dart; a mismatch sends
# every visitor who clicks "Get started" to a route the client does not serve.
APP_FRONTEND_AUTH_PREFIX=/auth

# Cloudflare Turnstile on the public contact form. Both empty keeps the widget
# DORMANT and that is the correct local state: the page loads no Cloudflare
# script without the site key, and the POST carries no verification rule
# without the secret. Setting only ONE of them is the broken state: a lone
# secret refuses every visitor, since no widget means no token to verify.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

RELAY_URL=http://localhost:8787
RELAY_SECRET=changeme-64-hex
RELAY_SIGNATURE_TTL=300
MONITOR_DEFAULT_REGIONS=us-east,eu-west

# Local proxy pool sources for the catalog monitoring engine. Each region
# may have a URL or file source that returns a newline-delimited list of
# `host:port:username:password` proxies. A region with an EMPTY source
# location is DECLARED BUT UNUSABLE: its pool never fills and the engine
# refuses that region, producing no reading at all. There is NO fallback to
# the regional-checker worker for a catalog monitor, and there must never be
# one; the worker keeps serving customer monitors only. The local engine
# wants AT LEAST 3 regions with a real source (the mathematical minimum is 2,
# but two leaves zero headroom when one region darkens). Left empty on
# local/dev the catalog simply reports no data, which is the honest answer.
UPTIZM_PROXY_EU_WEST_SOURCE_LOCATION=
UPTIZM_PROXY_US_EAST_SOURCE_LOCATION=
UPTIZM_PROXY_AP_SOURCE_LOCATION=

# How often, in minutes, the proxy lists are fetched and the pools refreshed.
UPTIZM_PROXY_REFRESH_MINUTES=60

# Proxy health tuning: base backoff (seconds) for a penalised exit, max
# backoff ceiling, and the failure threshold that triggers an operator alarm.
UPTIZM_PROXY_BASE_BACKOFF_SECONDS=300
UPTIZM_PROXY_MAX_BACKOFF_SECONDS=3600
UPTIZM_PROXY_FAILURE_THRESHOLD=3

# How many exits in the same region the probe engine may try when the target
# is ambiguously unreachable. A value of 2 means one initial attempt and one
# alternate. Never unbounded.
UPTIZM_PROXY_ATTEMPTS_PER_CHECK=2

# The region this server probes from DIRECTLY, with no proxy, when that region
# has no pool of its own. A MonitorRegion value (us-east, us-west, eu-west,
# eu-central, ap) or empty for none. It must name where this server actually is:
# one server is one vantage point, so this is a single region and never a list,
# and a region named here that we do not sit in is a fabricated location on a
# public page. A region that HAS a pool always prefers it. Empty is strictest:
# every unsourced region refuses, so nothing is measured and nothing is claimed.
UPTIZM_PROXY_DIRECT_REGION=

TIMESCALE_RAW_RETENTION_DAYS=90
TIMESCALE_HOURLY_RETENTION_DAYS=365
TIMESCALE_DAILY_RETENTION_DAYS=730

# Monitor-content archive (config/content-archive.php + the `content` disk in
# config/filesystems.php). Production points the disk root at the mounted
# Drive volume and sets a sentinel so the mount is verified live before every
# write: CONTENT_ARCHIVE_DISK_ROOT=/mnt/gdrive/kodizm.can/uptizm/content
# and CONTENT_ARCHIVE_SENTINEL=<a filename that must exist inside that root>.
CONTENT_ARCHIVE_MAX_BYTES=1048576
CONTENT_ARCHIVE_RETENTION_DAYS=30
CONTENT_ARCHIVE_DISK=content
CONTENT_ARCHIVE_QUEUE=content
CONTENT_ARCHIVE_QUEUE_BACKLOG_LIMIT=500
# Left unset on purpose. `KEY=` resolves to an empty string, not null, so
# setting these empty would make the mount guard hunt for a sentinel named ""
# and would root the disk at "". Uncomment and fill them only in production.
# CONTENT_ARCHIVE_SENTINEL=.uptizm-content-mounted
# CONTENT_ARCHIVE_DISK_ROOT=/mnt/gdrive/kodizm.can/uptizm/content
