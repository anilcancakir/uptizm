RELAY_SECRET=changeme-64-hex
RELAY_SIGNATURE_TTL=300
MONITOR_DEFAULT_REGIONS=us-east,eu-west

TIMESCALE_RAW_RETENTION_DAYS=90
TIMESCALE_HOURLY_RETENTION_DAYS=365
TIMESCALE_DAILY_RETENTION_DAYS=730
