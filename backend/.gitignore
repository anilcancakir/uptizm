# Filament's published assets (~4MB, mostly woff2 and JS bundles). Regenerated on
# every install by the `filament:upgrade` hook the installer added to
# composer.json's post-autoload-dump, so committing them is redundant binary churn
# on each Filament bump. Scoped to the `filament` subdirectory rather than to
# /public/css and /public/js, so the app's own assets there would still be tracked.
/public/css/filament
/public/fonts/filament
/public/js/filament
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

**/caddy
frankenphp
frankenphp-worker.php

/dump.rdb

# Stray SQLite databases (this backend runs on PostgreSQL; a bare
# DB_DATABASE=uptizm_dev with DB_CONNECTION=sqlite resolves to a file here).
/uptizm_dev
*.sqlite
