{
    "name": "uptizm-regional-checker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Synchronous Cloudflare Worker that executes monitor probes on behalf of the Uptizm Laravel API.",
    "scripts": {
        "dev": "wrangler dev --port 8787",
        "deploy": "wrangler deploy",
        "secret:set": "wrangler secret put RELAY_SECRET",
        "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.20.1",
        "@cloudflare/workers-types": "^5.20260708.1",
        "typescript": "^5.6.0",
        "vitest": "^4.1.0",
        "wrangler": "^4.110.0"
    },
    "dependencies": {
        "@sentry/cloudflare": "^10.70.0"
    }
}
