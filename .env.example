APP_NAME=
APP_ENV=
APP_DEBUG=
APP_KEY=

API_URL=
WEB_URL=

BROADCAST_CONNECTION=reverb
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=ws
REVERB_APP_KEY=

# OneSignal push notifications. The app id is a PUBLIC identifier the Web SDK
# needs client-side to open its own socket, and it carries no send capability;
# the OneSignal REST API key that CAN send notifications is server-only and
# never belongs here. Public by design, framed the same way REVERB_APP_KEY and
# SENTRY_DSN already are.
# ONESIGNAL_SAFARI_WEB_ID is optional and legacy: only pre-16.4 Safari (before
# native Web Push) needs a onesignal.com-hosted Safari site id to receive push
# at all.
ONESIGNAL_APP_ID=
ONESIGNAL_SAFARI_WEB_ID=

# RevenueCat's PUBLIC SDK key for the platform this build targets
# (appl_... on iOS, goog_... on Android). Public by design: it ships inside every
# binary, and the secret API key it is not lives on the server only
# (backend/.env REVENUECAT_SECRET_API_KEY). Left empty here on purpose.
# Not read yet: RevenueCatStoreService looks it up as
# `payments.revenuecat.public_sdk_key`, and uptizm publishes no lib/config/payments.dart.
REVENUECAT_PUBLIC_SDK_KEY=
