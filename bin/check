#!/usr/bin/env bash
#
# The verification gate for this repository. Runs every suite that guards a
# change, fans them out across cores, and reports one line per job.
#
# Usage:
#   bin/check                  every suite (analyze, design tokens, registry, lockfile, dart tests,
#                              pint, php tests, worker typecheck + tests)
#   bin/check --fast           only the static passes: analyze, design tokens, registry, lockfile,
#                              pint, worker typecheck
#   bin/check flutter          one half only; also `backend` and `worker`
#   bin/check flutter backend  several halves
#
# Jobs run concurrently and each one buffers its own output, so the logs are
# printed grouped per job at the end instead of interleaved into noise. The exit
# code is non-zero when any job failed, and the summary names which.
#
# Why bash and not an artisan command: several agents work this repo in parallel
# worktrees, and `bin/fsa` takes an AOT recompile lock per invocation. A shell
# script has nothing to contend over.

set -u -o pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT" || exit 1

FAST=0
SCOPES=""

usage() {
    cat <<'USAGE'
bin/check - the verification gate for this repository.

  bin/check                  every suite: analyze, design tokens, registry, lockfile, dart tests,
                             pint, php tests, worker typecheck + tests
  bin/check --fast           only the static passes: analyze, design tokens, registry, lockfile,
                             pint, worker typecheck
  bin/check flutter          one half only; also `backend` and `worker`
  bin/check flutter backend  several halves

Jobs run concurrently, each buffering its own output, so failing logs are printed
grouped per job instead of interleaved. Exits non-zero when any job failed and
names which one.
USAGE
}

for arg in "$@"; do
    case "$arg" in
        --fast) FAST=1 ;;
        flutter | backend | worker) SCOPES="$SCOPES $arg" ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "check: unknown argument '$arg' (expected --fast, flutter, backend, or worker)" >&2
            exit 2
            ;;
    esac
done

[ -z "$SCOPES" ] && SCOPES="flutter backend worker"

wants() {
    case " $SCOPES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Half the cores to each of the two heavy suites, so running them together does
# not oversubscribe the machine. Two is the floor; one process per suite spends
# more time on framework boot than on tests.
cores() {
    if command -v nproc >/dev/null 2>&1; then
        nproc
    elif command -v sysctl >/dev/null 2>&1; then
        sysctl -n hw.ncpu 2>/dev/null || echo 4
    else
        echo 4
    fi
}

TOTAL_CORES="$(cores)"
LANE=$((TOTAL_CORES / 2))
[ "$LANE" -lt 2 ] && LANE=2

# The twelve siblings are declared as hosted carets, so a checkout with no
# pubspec_overrides.yaml resolves every one of them from pub.dev and the suite then
# passes against the PUBLISHED packages rather than the working trees you are
# editing. That is the failure this guard exists for, and it is silent: nothing
# errors, the run is just measuring something else.
#
# `bootstrap_ignored_files` copies the file into a worktree before this runs, so
# reaching the error below means it is absent from the main checkout too.
require_local_siblings() {
    wants flutter || return 0

    # A fork resolving every sibling from pub.dev is the CORRECT answer, not a
    # mistake, and this repo is forked on purpose. The escape is opt-in so the
    # default still protects the common case: a working tree whose overrides
    # went missing and would otherwise certify the published packages.
    if [ "${CHECK_ALLOW_HOSTED:-}" = "1" ]; then
        [ -f pubspec_overrides.yaml ] || \
            echo "check: CHECK_ALLOW_HOSTED=1, resolving every sibling from pub.dev"
        return 0
    fi

    [ -f pubspec_overrides.yaml ] || {
        echo "check: pubspec_overrides.yaml is absent, so every sibling would resolve from pub.dev" >&2
        echo "check: and this run would certify the published packages, not your working trees." >&2
        echo "check: copy it from the main checkout, or from the block in .claude/rules/flutter-app.md." >&2
        echo "check: on a fork with no sibling checkouts, hosted IS correct: CHECK_ALLOW_HOSTED=1 bin/check" >&2
        exit 1
    }

    # The paths inside it are absolute, so a stale one points at a directory that
    # moved. pub reports that as a resolution failure with no hint of this file.
    #
    # Parsed with the standard library rather than PyYAML, and that is the whole
    # point of doing it by hand. `import yaml` used to sit outside the try, so on
    # any machine without PyYAML the ImportError left stdout empty, `missing`
    # came back empty, and the guard PASSED. `set -u -o pipefail` carries no
    # `-e`, so the failed substitution did not stop the run either: a stale file
    # sailed through the one check written to catch it. Nothing in this repo
    # declares PyYAML, so that was most machines.
    #
    # This file is HAND-written, so it carries whichever YAML style its author
    # reached for. Both are covered: the block form (`  <name>:` then
    # `    path: <abs>`) and the flow form (`  <name>: {path: <abs>}`), which is
    # the one `.claude/rules/flutter-app.md` and `AGENTS.md` themselves write.
    # An earlier version of this parser handled only the block form, so a
    # flow-style stale path passed exactly the way the PyYAML gap did.
    #
    # A `dependency_overrides` entry the parser cannot classify EXITS non-zero
    # rather than being skipped, because a shape it does not know is the one
    # thing that would let this go quiet a third time. A `git:` override is a
    # legitimate entry with no path to check, so its nested keys are ignored
    # rather than treated as unknown.
    local missing status
    missing="$(python3 - <<'PY'
import os, re, sys

try:
    lines = open('pubspec_overrides.yaml', encoding='utf-8').read().splitlines()
except OSError as exc:
    print(f"cannot read pubspec_overrides.yaml: {exc}", file=sys.stderr)
    sys.exit(2)

block_re = re.compile(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*(#.*)?$')
flow_re = re.compile(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*\{(.*)\}\s*(#.*)?$')
scalar_re = re.compile(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*[^{\s#][^#]*(#.*)?$')
path_re = re.compile(r'^    path:\s*(.+?)\s*$')
flow_path_re = re.compile(r'(?:^|,)\s*path:\s*([^,]+)')

def report(name, raw):
    path = raw.strip().strip('\'"')
    if not os.path.isdir(path):
        print(f"{name} -> {path}")

inside, current = False, None
for number, line in enumerate(lines, 1):
    if not line.strip() or line.lstrip().startswith('#'):
        continue
    if not line.startswith(' '):
        inside = line.startswith('dependency_overrides:')
        current = None
        continue
    if not inside:
        continue

    # Nested under an entry: only `path:` matters, and a `git:` block's own
    # keys fall through here harmlessly.
    if line.startswith('    '):
        matched = path_re.match(line)
        if matched and current:
            report(current, matched.group(1))
            current = None
        continue

    matched = flow_re.match(line)
    if matched:
        current = None
        inner = flow_path_re.search(matched.group(2))
        if inner:
            report(matched.group(1), inner.group(1))
        continue

    matched = block_re.match(line)
    if matched:
        current = matched.group(1)
        continue

    # A single-line version (`  file_picker: ^11.0.2`) declares no path. Clear
    # the pending name so a later `path:` cannot be attributed to it.
    if scalar_re.match(line):
        current = None
        continue

    print(f"unrecognised dependency_overrides line {number}: {line.strip()}", file=sys.stderr)
    sys.exit(3)
PY
)" && status=0 || status=$?

    # A parser that fell over must not read as "nothing is stale".
    if [ "$status" -ne 0 ]; then
        echo "check: could not read pubspec_overrides.yaml (exit $status)" >&2
        echo "check: fix the file, or set CHECK_ALLOW_HOSTED=1 to resolve from pub.dev instead." >&2
        exit 1
    fi

    [ -z "$missing" ] && return 0

    echo "check: pubspec_overrides.yaml points at paths that do not exist:" >&2
    echo "$missing" | sed 's/^/check:   /' >&2
    exit 1
}

# A worktree also has none of the gitignored runtime files the suites need, and each
# absence fails in its own confusing way: no `pubspec_overrides.yaml` and every
# sibling resolves from pub.dev so the suite silently measures the published
# packages, no `.env` and flutter_dotenv defaults BROADCAST_CONNECTION to null, no
# `backend/.env` and artisan aborts before saying why, no `.artisan/plugins.json`
# and every plugin command disappears, no `backend/public/build` and `@vite` throws
# under every page test.
#
# `.worktreeinclude` covers the first four on the `EnterWorktree` path. This list is
# the superset, and it is what the by-hand `git worktree add` path gets.
bootstrap_ignored_files() {
    local common_dir main_root file
    common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
    main_root="$(dirname "$common_dir")"

    [ "$main_root" = "$REPO_ROOT" ] && return 0
    [ -d "$main_root" ] || return 0

    for file in pubspec_overrides.yaml .env backend/.env .artisan/plugins.json \
        backend/public/build backend/workers/regional-checker/.dev.vars; do
        if [ ! -e "$REPO_ROOT/$file" ] && [ -e "$main_root/$file" ]; then
            mkdir -p "$(dirname "$REPO_ROOT/$file")"
            cp -R "$main_root/$file" "$REPO_ROOT/$file"
            echo "check: copied $file from the main worktree at $main_root"
        fi
    done
}

# `composer install` is the one bootstrap step this script will not do for you: a
# branch that touches composer.lock must be tested against its own vendor tree, and
# symlinking the main worktree's would quietly test the wrong one.
require_backend_vendor() {
    wants backend || return 0
    [ -f backend/vendor/autoload.php ] && return 0

    echo "check: backend/vendor is absent here. Run: (cd backend && composer install)" >&2
    exit 1
}

# The marketing and status views call `@vite`, which throws when the manifest is
# absent, and `public/build` is gitignored. Without it every page test fails with
# an error that names Vite and looks nothing like the feature under test.
ensure_vite_manifest() {
    wants backend || return 0
    [ -f backend/public/build/manifest.json ] && return 0

    echo "check: building backend assets (no vite manifest yet)"
    # `npm ci` needs a lockfile and exits non-zero without one, so fall back rather
    # than reporting an asset failure that is really a missing package-lock.json.
    ( cd backend && { npm ci --silent || npm install --silent; } && npm run build --silent ) >/dev/null 2>&1 ||
        echo "check: asset build failed; the page tests will fail on the vite manifest" >&2
}

# Order matters: the bootstrap is what puts pubspec_overrides.yaml into a worktree,
# and the guard below refuses without it.
bootstrap_ignored_files
require_local_siblings
require_backend_vendor
ensure_vite_manifest

# Resolve dependencies BEFORE fanning out, then run the two flutter commands with
# `--no-pub`. Each of them resolves on its own by default, and concurrently they
# race on `.dart_tool` and on `ios/Flutter/ephemeral`, which fails with a
# read-only-volume error that has nothing to do with the code. Serializing this
# step is not enough on its own: they re-resolve even after a warm `pub get`, so
# the flag is what actually removes the race. The worker needs the same treatment
# for a different reason: `npm run typecheck` cannot run without node_modules.
prepare() {
    local failed=0

    if wants flutter; then
        echo "check: resolving dart dependencies"
        flutter pub get >/dev/null || failed=1
    fi

    if wants worker && [ ! -d backend/workers/regional-checker/node_modules ]; then
        echo "check: installing worker dependencies"
        ( cd backend/workers/regional-checker && npm ci ) >/dev/null || failed=1
    fi

    if [ "$failed" -ne 0 ]; then
        echo "check: dependency resolution failed" >&2
        exit 1
    fi
}

JOB_NAMES=""
JOB_PIDS=""

LOG_DIR="$(mktemp -d)" || exit 1
# Kill the suites on the way out too: a tool-call timeout would otherwise leave
# paratest and flutter test chewing every core while their log directory is deleted
# from under them.
trap 'rm -rf "$LOG_DIR"; [ -n "$JOB_PIDS" ] && kill $JOB_PIDS 2>/dev/null' EXIT INT TERM

start() {
    local name="$1"
    shift
    ( "$@" ) >"$LOG_DIR/$name.log" 2>&1 &
    JOB_PIDS="$JOB_PIDS $!"
    JOB_NAMES="$JOB_NAMES $name"
}

run_flutter_analyze() { flutter analyze --no-pub; }
run_flutter_test() { flutter test --no-pub --concurrency="$LANE"; }
run_backend_pint() { cd backend && vendor/bin/pint --test; }
# `config:clear` first, exactly as composer.json's test script does. A
# bootstrap/cache/config.php left by any artisan optimize outranks phpunit.xml's
# DB_CONNECTION=sqlite, and the suite would then migrate:fresh the real dev database.
run_backend_test() {
    cd backend && php artisan config:clear >/dev/null && php artisan test --parallel --processes="$LANE"
}
run_worker_typecheck() { cd backend/workers/regional-checker && npm run --silent typecheck; }
# The worker's suite runs in real workerd through @cloudflare/vitest-pool-workers,
# so it boots a runtime rather than a test framework and does not belong with the
# static passes. It is the only local gate over the component whose wrong answer
# wakes the on-call, and until it existed `tsc --noEmit` was the whole of that
# gate.
run_worker_test() { cd backend/workers/regional-checker && npm run --silent test; }
# Regex, not an AST, and fast enough (bash + awk + grep over lib/**/*.dart) to
# belong in --fast alongside the other static passes. No flutter pub get or
# node_modules dependency, so it needs neither `wants flutter`'s dependency
# resolution nor a scope of its own beyond gating on flutter.
run_design_tokens() { bin/design-tokens; }
# The registry is what every rule tells an agent to read before writing a widget, so
# a stale one sends it to scaffold a second copy of a component that already exists.
# Hand-maintained it drifts within days; generated, it can be verified.
run_registry() { bin/sync-registry --check && echo "registry: current"; }
# The committed pubspec.lock has to be the HOSTED-only resolution. A lock generated
# while pubspec_overrides.yaml is active encodes the sibling working trees, which
# resolve on this machine and nowhere else, so committing one breaks CI and the
# deploy at once. A local `pub get` rewrites the lock that way constantly, which is
# why this is a gate rather than a note. Only the STAGED content is checked: a dirty
# working copy during local development is expected.
run_lockfile() {
    local staged
    staged=$(git show :pubspec.lock 2>/dev/null) || {
        echo "pubspec.lock is not tracked; commit the hosted-only lock" >&2
        return 1
    }
    # `source: path` rather than a relative `path: "../"`. The overrides file holds
    # ABSOLUTE paths on purpose, so a poisoned lock reads `path: "/Users/..."` with
    # `relative: false` and a relative-path pattern would match it zero times. The
    # source line is the categorical test and covers both forms.
    if printf '%s' "$staged" | grep -q 'source: path'; then
        echo "pubspec.lock encodes local sibling paths. Regenerate it hosted-only:" >&2
        echo "  mv pubspec_overrides.yaml /tmp/ && flutter pub get && git add pubspec.lock" >&2
        echo "  mv /tmp/pubspec_overrides.yaml ." >&2
        return 1
    fi
    echo "lockfile: hosted-only, no local paths"
}

echo "check: ${SCOPES# } | $TOTAL_CORES cores, $LANE per suite$([ "$FAST" -eq 1 ] && echo ' | static only')"
prepare
echo

wants flutter && start "flutter-analyze" run_flutter_analyze
wants flutter && start "design-tokens" run_design_tokens
wants flutter && start "registry" run_registry
wants flutter && start "lockfile" run_lockfile
wants backend && start "backend-pint" run_backend_pint
wants worker && start "worker-typecheck" run_worker_typecheck

if [ "$FAST" -eq 0 ]; then
    wants flutter && start "flutter-test" run_flutter_test
    wants backend && start "backend-test" run_backend_test
    wants worker && start "worker-test" run_worker_test
fi

# Collect in launch order so the summary is stable run to run.
FAILED=""
set -- $JOB_PIDS
for name in $JOB_NAMES; do
    pid="$1"
    shift
    if wait "$pid"; then
        printf '  ok    %s\n' "$name"
    else
        printf '  FAIL  %s\n' "$name"
        FAILED="$FAILED $name"
    fi
done

if [ -n "$FAILED" ]; then
    for name in $FAILED; do
        echo
        echo "───── $name ─────"
        cat "$LOG_DIR/$name.log"
    done
    echo
    echo "check: failed:${FAILED}"
    exit 1
fi

echo
echo "check: all green | ${SCOPES# }$([ "$FAST" -eq 1 ] && echo ' | static only, no tests ran')"
