# Production values for the Flutter web client.
#
# EVERYTHING HERE SHIPS TO EVERY BROWSER. `.env` is bundled as a pubspec asset
# (see pubspec.yaml flutter.assets), which is not optional: without it
# flutter_dotenv silently defaults BROADCAST_CONNECTION to null on web and
# realtime never connects. So this file holds only values that are public by
# design. REVERB_APP_KEY is one of them: the Pusher protocol puts the app key in
# the client, and private channels are still gated by the auth endpoint. The
# Reverb APP SECRET is server-side only and must never appear here.
#
# Build procedure: copy this over `.env`, build, then restore the dev `.env`.
#   cp .env .env.local.bak && cp .env.production .env
#   flutter build web --release
#   mv .env.local.bak .env
APP_NAME=Uptizm
APP_ENV=production
APP_DEBUG=false
APP_KEY=

API_URL=https://api.uptizm.com/api/v1
WEB_URL=https://uptizm.com

# This build's OWN origin, where a hosted checkout and the billing portal
# return the customer. Not WEB_URL: that is the marketing site, which has no
# /teams/* route.
CHECKOUT_WEB_ORIGIN=https://app.uptizm.com

BROADCAST_CONNECTION=reverb
REVERB_HOST=api.uptizm.com
REVERB_PORT=443
REVERB_SCHEME=wss
REVERB_APP_KEY=dbaaf48b734db1674ee6f8f8e701a5d2d9d3d286

# Sentry, project `uptizm-app`. A DSN is a write-only credential (it can file an
# event and read nothing), and every browser-delivered SDK ships one in public
# bytes, so it belongs in this file by the same rule REVERB_APP_KEY does.
#
# It lives HERE and not in the development `.env`, which is the entire mechanism
# keeping local runs out of the production project: `lib/config/sentry.dart`
# also requires APP_ENV to be exactly `production`, so both would have to be
# copied for a development machine to start reporting.
SENTRY_DSN=https://1d4ff7cd3ebf621a2f2eef4cfacea531@o4511168697794560.ingest.de.sentry.io/4511908894081104

# The build this bundle came from, so an issue names a deploy. Left EMPTY here
# on purpose: `deploy/README.md` rewrites it with the commit SHA during the
# build, and the same value is passed to the source-map upload. A hardcoded
# value would silently attach every future release's errors to one stale name.
SENTRY_RELEASE=
