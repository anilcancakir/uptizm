# Production values for the Flutter web client.
#
# EVERYTHING HERE SHIPS TO EVERY BROWSER. `.env` is bundled as a pubspec asset
# (see pubspec.yaml flutter.assets), which is not optional: without it
# flutter_dotenv silently defaults BROADCAST_CONNECTION to null on web and
# realtime never connects. So this file holds only values that are public by
# design. REVERB_APP_KEY is one of them: the Pusher protocol puts the app key in
# the client, and private channels are still gated by the auth endpoint. The
# Reverb APP SECRET is server-side only and must never appear here.
#
# Build procedure: copy this over `.env`, build, then restore the dev `.env`.
#   cp .env .env.local.bak && cp .env.production .env
#   flutter build web --release
#   mv .env.local.bak .env
APP_NAME=Uptizm
APP_ENV=production
APP_DEBUG=false
APP_KEY=

API_URL=https://api.uptizm.com/api/v1

BROADCAST_CONNECTION=reverb
REVERB_HOST=api.uptizm.com
REVERB_PORT=443
REVERB_SCHEME=wss
REVERB_APP_KEY=dbaaf48b734db1674ee6f8f8e701a5d2d9d3d286
